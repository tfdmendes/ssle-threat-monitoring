{
  "uid": "node-resources",
  "title": "Node Resources",
  "description": "Resources attributed to each K3s Node through Incus. The two Nodes share the Kali VM CPU, memory and backing filesystem.",
  "schemaVersion": 42,
  "version": 2,
  "timezone": "browser",
  "refresh": "15s",
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "SSLE",
    "infrastructure"
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(incus_cpu_effective_total{job=\"incus-nodes\"}, node)",
        "definition": "label_values(incus_cpu_effective_total{job=\"incus-nodes\"}, node)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Node Resources",
      "type": "link",
      "url": "/d/node-resources",
      "keepTime": true
    },
    {
      "title": "Pod and Container Resources",
      "type": "link",
      "url": "/d/pod-container-cpu",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Incus collection",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"incus-nodes\"}",
          "legendFormat": "Incus",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "CPU capacity (shared cores)",
      "description": "Both Nodes run in the same Kali VM. These are CPUs accessible to each Node, not dedicated CPUs. Do not add the values to calculate physical capacity.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "incus_cpu_effective_total{job=\"incus-nodes\",node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "RAM capacity (shared)",
      "description": "Memory reported by Incus. The Nodes have no separate memory limits and share the Kali VM memory.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "incus_memory_MemTotal_bytes{job=\"incus-nodes\",node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Root space available (shared)",
      "description": "The existing Node Exporter in the Prometheus container sees the same /dev/vda3 filesystem as both K3s Nodes. This is shared free space, not an independent disk allocation for each Node.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"}",
          "legendFormat": "Kali filesystem",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "CPU usage (cores)",
      "description": "CPU time attributed by Incus to each Node, including its Kubernetes services and Pods. One core is one CPU second per second.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(incus_cpu_seconds_total{job=\"incus-nodes\",node=~\"$node\",mode=~\"user|system\"}[$__rate_interval]))",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "RAM usage",
      "description": "Estimated memory in use, calculated from the total and available memory reported by Incus. Reclaimable memory is included in the available-memory estimate.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "incus_memory_MemTotal_bytes{job=\"incus-nodes\",node=~\"$node\"} - incus_memory_MemAvailable_bytes{job=\"incus-nodes\",node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Disk I/O",
      "description": "Block I/O attributed to each Incus instance. The backing disk is shared. Cached application reads need not result in block-device reads.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(incus_disk_read_bytes_total{job=\"incus-nodes\",node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}} read",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "sum by (node) (rate(incus_disk_written_bytes_total{job=\"incus-nodes\",node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}} write",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Network traffic",
      "description": "Traffic on each Node external interface, eth0. Loopback, bridges and virtual Pod interfaces are excluded to avoid counting the same traffic more than once.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(incus_network_receive_bytes_total{job=\"incus-nodes\",node=~\"$node\",device=\"eth0\"}[$__rate_interval])",
          "legendFormat": "{{node}} receive",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "rate(incus_network_transmit_bytes_total{job=\"incus-nodes\",node=~\"$node\",device=\"eth0\"}[$__rate_interval])",
          "legendFormat": "{{node}} transmit",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Root filesystem usage (shared)",
      "description": "Used fraction of the shared filesystem. This panel is independent of the Node selection because both Nodes use the same backing filesystem.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "1 - node_filesystem_free_bytes{job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"}",
          "legendFormat": "Kali filesystem",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Network errors and drops",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(incus_network_receive_errs_total{job=\"incus-nodes\",node=~\"$node\",device=\"eth0\"}[$__rate_interval]) + rate(incus_network_transmit_errs_total{job=\"incus-nodes\",node=~\"$node\",device=\"eth0\"}[$__rate_interval])",
          "legendFormat": "{{node}} errors",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "rate(incus_network_receive_drop_total{job=\"incus-nodes\",node=~\"$node\",device=\"eth0\"}[$__rate_interval]) + rate(incus_network_transmit_drop_total{job=\"incus-nodes\",node=~\"$node\",device=\"eth0\"}[$__rate_interval])",
          "legendFormat": "{{node}} drops",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
